<?xml version="1.0"?>
<!--
  AppLocker path-based allow policy for the meerkat / mk binary.

  WHY PATH-BASED: meerkat.exe is not Authenticode-signed, so a
  FilePublisherRule is not possible. These FilePathRule entries allow
  the binary at the standard meerkat install locations. See
  deploy/defender/README.md for rationale and the Authenticode
  upgrade path.

  SECURITY NOTE: AppLocker path rules in user-writable directories
  are weaker than publisher or hash rules — any executable placed at
  the path is allowed. The meerkat install dirs are user-profile
  scoped (the user already controls them), so the added exposure is
  limited, but if your posture requires it, use the hash rules from
  generate-hash-rules.ps1 instead.

  PREREQUISITES:
  - The Application Identity service (AppIDSvc) must be running.
  - AppLocker enforces the EXE collection only once at least one EXE
    rule exists; this template therefore also includes the default
    "Everyone / Program Files" and "Everyone / Windows" allow rules
    so you don't accidentally lock down the rest of the OS when you
    merge. REMOVE those two defaults if you already manage the EXE
    collection elsewhere and are merging with -Merge.

  DEPLOY:
    Set-AppLockerPolicy -XmlPolicy .\applocker-meerkat-path-policy.xml -Merge
  TEST FIRST: set EnforcementMode="AuditOnly" (already set below),
  review events in
  Microsoft-Windows-AppLocker/EXE and DLL, then flip to "Enabled".

  %OSDRIVE%, %PROGRAMFILES%, %WINDIR% are AppLocker path variables.
  There is no built-in variable for the per-user profile, so the
  user-profile paths use the literal %OSDRIVE%\Users\*\... form.
-->
<AppLockerPolicy Version="1">
  <RuleCollection Type="Exe" EnforcementMode="AuditOnly">

    <!-- meerkat: %LOCALAPPDATA%\Programs\meerkat\* -->
    <FilePathRule Id="b3a1f0c2-9d4e-4b21-8a77-meerkatlocal01"
                  Name="meerkat - %LOCALAPPDATA%\Programs\meerkat"
                  Description="Allow meerkat/mk from per-user LocalAppData install dir"
                  UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePathCondition Path="%OSDRIVE%\Users\*\AppData\Local\Programs\meerkat\*" />
      </Conditions>
    </FilePathRule>

    <!-- meerkat: %USERPROFILE%\bin\* -->
    <FilePathRule Id="b3a1f0c2-9d4e-4b21-8a77-meerkatuser002"
                  Name="meerkat - %USERPROFILE%\bin"
                  Description="Allow meerkat/mk from per-user bin dir"
                  UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePathCondition Path="%OSDRIVE%\Users\*\bin\*" />
      </Conditions>
    </FilePathRule>

    <!-- meerkat: %ProgramFiles%\meerkat\* (admin/machine-wide) -->
    <FilePathRule Id="b3a1f0c2-9d4e-4b21-8a77-meerkatpf00003"
                  Name="meerkat - %ProgramFiles%\meerkat"
                  Description="Allow meerkat/mk from machine-wide Program Files install dir"
                  UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePathCondition Path="%PROGRAMFILES%\meerkat\*" />
      </Conditions>
    </FilePathRule>

    <!-- Default OS allow rules — keep when this is your ONLY EXE
         policy, REMOVE when merging into an existing managed EXE
         collection. -->
    <FilePathRule Id="921cc481-6e17-4653-8f75-050b80acca20"
                  Name="(Default) All files in Program Files"
                  Description="Allows members of the Everyone group to run applications in Program Files."
                  UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePathCondition Path="%PROGRAMFILES%\*" />
      </Conditions>
    </FilePathRule>
    <FilePathRule Id="a61c8b2c-a319-4cd0-9690-d2177cad7b51"
                  Name="(Default) All files in Windows folder"
                  Description="Allows members of the Everyone group to run applications in the Windows folder."
                  UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePathCondition Path="%WINDIR%\*" />
      </Conditions>
    </FilePathRule>

  </RuleCollection>
</AppLockerPolicy>
