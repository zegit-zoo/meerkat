{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "meerkat chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "objectList": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/objectList"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "mcp",
            "http"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "stateful": {
          "type": "boolean"
        },
        "insecureNoAuth": {
          "type": "boolean"
        },
        "securityTxt": {
          "type": "boolean"
        },
        "apiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "mountAsFile": {
              "type": "boolean"
            }
          }
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contentSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "raw": {
          "type": "string"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "sizeLimit": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "enum": [
            "",
            "Memory"
          ]
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "traversalLogKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "$ref": "#/definitions/nonEmptyString"
            },
            "envName": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretName",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "secretName": {
                "$ref": "#/definitions/nonEmptyString"
              },
              "key": {
                "$ref": "#/definitions/nonEmptyString"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "$ref": "#/definitions/objectList"
    },
    "extraEnvFrom": {
      "$ref": "#/definitions/objectList"
    },
    "extraVolumes": {
      "$ref": "#/definitions/objectList"
    },
    "extraVolumeMounts": {
      "$ref": "#/definitions/objectList"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretName": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "parentRefs": {
          "$ref": "#/definitions/objectList"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "$ref": "#/definitions/objectList"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "parentRefs": {
            "minItems": 1
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "$ref": "#/definitions/objectList"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "$ref": "#/definitions/objectList"
            }
          }
        }
      }
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "$ref": "#/definitions/objectList"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "$ref": "#/definitions/objectList"
    },
    "priorityClassName": {
      "type": "string"
    }
  }
}
